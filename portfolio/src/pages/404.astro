---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Igor Matviichuk" description="This page could not be found.">
  <section class="page-head" style="max-width: var(--max-width-page); margin: 0 auto; text-align: left;">
    <p class="eyebrow">404</p>
    <h1 class="page-head__title">Page not found</h1>
    <p class="page-head__lede">The page you're looking for doesn't exist or may have moved.</p>
    <div class="page-head__actions">
      <a class="btn btn--primary" href="/">Back to homepage</a>
    </div>
  </section>
</BaseLayout>
